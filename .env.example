# ==============================================================================
# Clinical SAS Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure your environment variables / ~/.authinfo

# --- SAS OnDemand for Academics (ODA) Credentials ---
# Typically configured in ~/_authinfo (Linux/macOS) or %USERPROFILE%\_authinfo (Windows) with line:
# oda user your_email@example.com password your_password
#
# Optional overrides:
# SAS_REMOTE_BASE=/home/<your_username>/SAS
# JAVA_HOME=C:\Path\To\Java8_JRE

# --- External API Keys (Optional for Extended Data Catalogues) ---
# Socrata Open Data (e.g. Dutch RDW Open Data Views API):
API_KEY_ID=your_socrata_key_id
RDW_API_KEY_SECRET=your_socrata_key_secret

# Zenodo REST API:
ZENODO_API_TOKEN=your_zenodo_token

